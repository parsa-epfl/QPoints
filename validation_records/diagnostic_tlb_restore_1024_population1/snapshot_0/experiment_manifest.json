{
  "kind": "experiment",
  "schema_version": 1,
  "component": "restore.tlb",
  "title": "Single-core 1024-entry TLB diagnostic with 1s population and post-fix proof run",
  "lifecycle": {
    "state": "investigation",
    "retention_policy": "keep"
  },
  "intent": {
    "source_path": "<QPoints>/validation_records/diagnostic_tlb_restore_1024_population1/snapshot_0/INTENT.txt",
    "staged_path": "INTENT.txt",
    "text": "Preserve both the failed and corrected 1024-entry source-side and target-side TLB diagnostics on the single-core tlb_resident_rw lineage, including the overwrite-root-cause analysis, the SME-off control, and the final cold/restored gem5 proof that TLB restoration reaches zero misses once the source-side configuration is preserved."
  },
  "commands": [
    {
      "label": "regenerate-init-warmed-postfix",
      "cwd": "<qflex>",
      "argv": [
        "xargs",
        "-a",
        "/tmp/qflex_init_1024_smeoff.args",
        "--",
        "./qflex",
        "initialize",
        "--skip-generate-cfg",
        "--fallback-cycles",
        "100000",
        "--loadvm-name",
        "loaded"
      ]
    },
    {
      "label": "functional-warm-snapshot0-postfix",
      "cwd": "<qflex>",
      "argv": [
        "xargs",
        "-a",
        "/tmp/qflex_pop1_smeoff.args",
        "--",
        "./qflex",
        "fw",
        "--sample-size",
        "1",
        "--loadvm-name",
        "init_warmed"
      ]
    },
    {
      "label": "convert-single-postfix",
      "cwd": "<qflex>",
      "argv": [
        "./qflex",
        "qpoints",
        "convert-single",
        "--qflex-ckp-dir",
        "/mnt/sdb/aansari/experiments/single-core",
        "--gem5-ckp-dir",
        "/mnt/sdb/aansari/checkpoints/single-core",
        "--core-count",
        "1",
        "--memory-gb",
        "16",
        "--base",
        "/mnt/sdb/aansari/images/single-core.qcow2",
        "--snapshot",
        "snapshot_0",
        "--overwrite"
      ]
    },
    {
      "label": "cold-run-postfix",
      "cwd": "<qflex>",
      "argv": [
        "./qflex",
        "qpoints",
        "run-gem5",
        "--gem5-ckp-dir",
        "/mnt/sdb/aansari/checkpoints/single-core",
        "--experiment",
        "tlb1024_cold_smeoff_postfix_snapshot0_100k_1024",
        "--snapshot",
        "snapshot_0",
        "--inst",
        "100000",
        "--core-count",
        "1",
        "--sim-config",
        "/tmp/tlb_cold_1024.args"
      ]
    },
    {
      "label": "restored-run-postfix",
      "cwd": "<qflex>",
      "argv": [
        "./qflex",
        "qpoints",
        "run-gem5",
        "--gem5-ckp-dir",
        "/mnt/sdb/aansari/checkpoints/single-core",
        "--experiment",
        "tlb1024_restore_smeoff_postfix_snapshot0_100k_1024",
        "--snapshot",
        "snapshot_0",
        "--inst",
        "100000",
        "--core-count",
        "1",
        "--sim-config",
        "/tmp/tlb_restore_1024.args"
      ]
    },
    {
      "label": "regenerate-init-warmed",
      "cwd": "<qflex>",
      "argv": [
        "xargs",
        "-a",
        "/tmp/qflex_init_1024.args",
        "--",
        "./qflex",
        "initialize",
        "--skip-generate-cfg",
        "--fallback-cycles",
        "100000",
        "--loadvm-name",
        "tlb_loaded"
      ]
    },
    {
      "label": "functional-warm-snapshot0",
      "cwd": "<qflex>",
      "argv": [
        "xargs",
        "-a",
        "/tmp/qflex_pop1.args",
        "--",
        "./qflex",
        "fw",
        "--sample-size",
        "1",
        "--loadvm-name",
        "init_warmed"
      ]
    },
    {
      "label": "convert-single",
      "cwd": "<qflex>",
      "argv": [
        "./qflex",
        "qpoints",
        "convert-single",
        "--qflex-ckp-dir",
        "/mnt/sdb/aansari/experiments/single-core",
        "--gem5-ckp-dir",
        "/mnt/sdb/aansari/checkpoints/single-core",
        "--core-count",
        "1",
        "--memory-gb",
        "16",
        "--base",
        "/mnt/sdb/aansari/images/single-core.qcow2",
        "--snapshot",
        "snapshot_0",
        "--overwrite"
      ]
    },
    {
      "label": "cold-run",
      "cwd": "<QPoints>",
      "argv": [
        "bash",
        "run_gem5.sh",
        "--gem5-ckp-dir",
        "/mnt/sdb/aansari/checkpoints/single-core",
        "--experiment",
        "tlb1024_cold_snapshot0_100k",
        "--snapshot",
        "snapshot_0",
        "--inst",
        "100000",
        "--cores",
        "1",
        "--sim-config",
        "/tmp/classic_atomic_tlb1024.args"
      ]
    },
    {
      "label": "restored-run",
      "cwd": "<QPoints>",
      "argv": [
        "bash",
        "run_gem5.sh",
        "--gem5-ckp-dir",
        "/mnt/sdb/aansari/checkpoints/single-core",
        "--experiment",
        "tlb1024_restore_snapshot0_100k",
        "--snapshot",
        "snapshot_0",
        "--inst",
        "100000",
        "--cores",
        "1",
        "--sim-config",
        "/tmp/classic_atomic_tlb1024_restore.args"
      ]
    }
  ],
  "artifacts": [
    {
      "label": "intent",
      "category": "intent",
