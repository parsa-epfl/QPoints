# Flexus-aligned MOESI reference for snapshot_0 comparison.

--l1i_size=64kB
--l1i_assoc=8
--l1d_size=64kB
--l1d_assoc=8
--l2_size=4MB
--l2_assoc=16
--mem-channels=1
--mem-ranks=4
--restore-llc-state
--restore-l1d-state
--restore-l1i-state
--restore-btb-state
--restore-tage-state
--restore-tlb-state

# MOESI LLC / directory pressure knobs.
--mem-type=SimpleMemory
--simple-mem-latency=45ns
--ports=8
--recycle-latency=1
--l1-data-latency=1
--l1-tag-latency=1
--l2-data-latency=3
--l2-tag-latency=1
--l1-request-latency=2
--l1-response-latency=2
--l2-request-latency=1
--l2-response-latency=1
--directory-latency=1
--to-memory-controller-latency=1
--l1-tbes=256
--l2-tbes=256
--dir-tbes=256

# Core geometry aligned toward current Flexus timing.cfg.
--fetch-width=8
--decode-width=8
--rename-width=8
--dispatch-width=8
--issue-width=8
--wb-width=8
--commit-width=4
--fetch-queue-size=48
--rob-entries=140
--sq-entries=12
