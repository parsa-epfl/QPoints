# MOESI Flexus-aligned reference plus larger load/store queues.
# This is a sensitivity probe for SQ/LQ pressure, not a new baseline.

--l1i_size=64kB
--l1i_assoc=8
--l1d_size=64kB
--l1d_assoc=8
--l2_size=4MB
--l2_assoc=16
--mem-channels=1
--mem-ranks=4
--itb-size=64
--dtb-size=64
--have-large-asid-64
--restore-llc-state
--restore-l1d-state
--restore-l1i-state
--restore-btb-state
--restore-tage-state
--restore-tlb-state

--mem-type=SimpleMemory
--simple-mem-latency=45ns
--ports=8
--recycle-latency=1
--l1-data-latency=1
--l1-tag-latency=1
--l2-data-latency=3
--l2-tag-latency=1
--l1-request-latency=2
--l1-response-latency=2
--l2-request-latency=1
--l2-response-latency=1
--directory-latency=1
--to-memory-controller-latency=1
--l1-tbes=256
--l2-tbes=256
--dir-tbes=256

--fetch-width=8
--decode-width=8
--rename-width=8
--dispatch-width=8
--issue-width=8
--wb-width=8
--commit-width=4
--fetch-queue-size=48
--rob-entries=140
--lq-entries=128
--sq-entries=64
